# ---- Uygulama ----
NEXT_PUBLIC_SITE_URL=https://havre.ca
NEXT_PUBLIC_DEFAULT_LOCALE=en-CA
NODE_ENV=development

# ---- Veritabani (Kanada bolgesi: ca-central-1 / northamerica-northeast1) ----
DATABASE_URL=postgresql://havre:havre@localhost:5432/havre

# ---- Kimlik dogrulama ----
# Oturum cerezlerini imzalar. Uretimde ZORUNLU; yoksa uygulama acilista durur.
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Sosyal giris — anahtar bos birakilirsa o dugme arayuzde HIC GORUNMEZ.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple'da clientSecret bir JWT'dir ve en fazla 6 ay gecerlidir; yenilenmesi gerekir.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_ID=

# ---- Stripe Connect ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---- Alan duzeyinde sifreleme ----
# Tam adres ve SIN gibi alanlari sifreler. Uretimde ZORUNLU.
# Bu anahtar KAYBOLURSA sifreli alanlar geri okunamaz — yedekleyin.
#   openssl rand -base64 32
FIELD_ENCRYPTION_KEY=

# ---- Kimlik / adli sicil (Certn) ----
# Bostayken SAHTE saglayici calisir (gelistirme). Uretimde bos birakmak hata verir:
# sahte saglayiciyla "dogrulanmis bakici" demek dayanaksiz bir iddia olurdu.
CERTN_API_KEY=
CERTN_WEBHOOK_SECRET=

# ---- E-posta / SMS ----
# RESEND_API_KEY bostayken e-postalar GONDERILMEZ, terminale basilir
# (gelistirme kolayligi). NODE_ENV=production iken bos birakmak hata verir.
RESEND_API_KEY=
MAIL_FROM=Havre <no-reply@havre.ca>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ---- Fotograflar ----
# Bos birakilirsa site depodaki marka renkli yer tutucularla calisir.
# Anahtar: https://unsplash.com/developers -> New Application -> Access Key
# Sonra: npm run photos:fetch -w @havre/web
UNSPLASH_ACCESS_KEY=

# ---- Depolama (yuklenen fotograflar) ----
# Bugun yalnizca "local" var: dosyalar UPLOAD_DIR altina yaziliyor ve
# /media/... adresinden servis ediliyor.
#
# URETIMDE YEREL DISK YETMEZ: dagitim sirasinda silinir, ikinci sunucu
# goremez. Bu yuzden NODE_ENV=production + local secilirse sunucu acilista
# HATA VERIR. Tek sunucuda bilerek calisiyorsaniz ALLOW_LOCAL_STORAGE=1.
STORAGE_DRIVER=local
UPLOAD_DIR=
ALLOW_LOCAL_STORAGE=

# S3/R2 surucusu HENUZ YAZILMADI; anahtarlar geldiginde
# apps/web/src/lib/storage.ts icine eklenecek.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Gozlemleme ----
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
