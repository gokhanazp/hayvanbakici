# ---- Uygulama ----
NEXT_PUBLIC_SITE_URL=https://havre.ca
NEXT_PUBLIC_DEFAULT_LOCALE=en-CA
NODE_ENV=development

# ---- Veritabani (Kanada bolgesi: ca-central-1 / northamerica-northeast1) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/havre

# ---- Stripe Connect ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---- Kimlik / adli sicil (Certn) ----
CERTN_API_KEY=
CERTN_WEBHOOK_SECRET=

# ---- E-posta / SMS ----
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ---- Depolama ----
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Gozlemleme ----
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
