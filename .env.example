# ---- Uygulama ----
NEXT_PUBLIC_SITE_URL=https://havre.ca
NEXT_PUBLIC_DEFAULT_LOCALE=en-CA
NODE_ENV=development

# ---- Veritabani (Kanada bolgesi: ca-central-1 / northamerica-northeast1) ----
DATABASE_URL=postgresql://havre:havre@localhost:5432/havre

# ---- Kimlik dogrulama ----
# Oturum cerezlerini imzalar. Uretimde ZORUNLU; yoksa uygulama acilista durur.
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Sosyal giris — anahtar bos birakilirsa o dugme arayuzde HIC GORUNMEZ.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple'da clientSecret bir JWT'dir ve en fazla 6 ay gecerlidir; yenilenmesi gerekir.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_ID=

# ---- Stripe Connect ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---- Alan duzeyinde sifreleme ----
# Tam adres ve SIN gibi alanlari sifreler. Uretimde ZORUNLU.
# Bu anahtar KAYBOLURSA sifreli alanlar geri okunamaz — yedekleyin.
#   openssl rand -base64 32
FIELD_ENCRYPTION_KEY=

# ---- Kimlik / adli sicil (Certn) ----
# Bostayken SAHTE saglayici calisir (gelistirme). Uretimde bos birakmak hata verir:
# sahte saglayiciyla "dogrulanmis bakici" demek dayanaksiz bir iddia olurdu.
CERTN_API_KEY=
CERTN_WEBHOOK_SECRET=

# ---- E-posta ----
# Uc saglayici, tek arayuz: console (gelistirme), ses, resend.
#
# Hicbiri tanimli degilse e-postalar GONDERILMEZ, terminale basilir ve
# /account/dev-inbox sayfasinda goruntulenir. NODE_ENV=production iken
# saglayici yoksa uygulama ACILISTA hata verir — sessizce konsola dusen
# bir dogrulama e-postasi, kullanicinin hic giris yapamamasi demektir.
#
# MAIL_DRIVER bos birakilirsa eldeki ayardan cikarilir (SES_REGION varsa
# ses, yoksa RESEND_API_KEY varsa resend). IKISI DE tanimliysa MAIL_DRIVER
# zorunlu: "hangisi gonderdi" tahmine birakilmamali.
MAIL_DRIVER=
MAIL_FROM=Havre <no-reply@havre.ca>

# Amazon SES. ca-central-1 secilirse gonderim Kanada'da isleniyor ve
# "veriniz Kanada'da" cumlesi e-posta tarafinda da bozulmuyor.
# Kimlik bilgileri verilmezse SDK kendi varsayilan zincirine duser
# (AWS uzerinde calisiyorsan rol yeterli).
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# Istege bagli: geri donen ve sikayet edilen adresleri SES'te izlemek icin.
SES_CONFIGURATION_SET=
# YALNIZCA YEREL DENEME icin (moto/LocalStack). Uretimde BOS birakilir.
SES_ENDPOINT=

# Resend (Kanada bolgesi YOK — Law 25 sinir otesi transfer degerlendirmesi gerekir)
RESEND_API_KEY=

# Testlerdeki gercek SES gonderimi YALNIZCA bu verilirse calisir:
#   pip install "moto[all,server]" && python3 -m moto.server -p 5999
#   SES_TEST_ENDPOINT=http://127.0.0.1:5999 npm test -w @havre/auth
SES_TEST_ENDPOINT=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ---- Fotograflar ----
# Bos birakilirsa site depodaki marka renkli yer tutucularla calisir.
# Anahtar: https://unsplash.com/developers -> New Application -> Access Key
# Sonra: npm run photos:fetch -w @havre/web
UNSPLASH_ACCESS_KEY=

# ---- Depolama (yuklenen fotograflar) ----
# Bugun yalnizca "local" var: dosyalar UPLOAD_DIR altina yaziliyor ve
# /media/... adresinden servis ediliyor.
#
# URETIMDE YEREL DISK YETMEZ: dagitim sirasinda silinir, ikinci sunucu
# goremez. Bu yuzden NODE_ENV=production + local secilirse sunucu acilista
# HATA VERIR. Tek sunucuda bilerek calisiyorsaniz ALLOW_LOCAL_STORAGE=1.
STORAGE_DRIVER=local
UPLOAD_DIR=
ALLOW_LOCAL_STORAGE=

# S3 SURUCUSU (STORAGE_DRIVER=s3)
#
# SAGLAYICIYA BAGLI DEGIL: uc nokta bir ayar oldugu icin Supabase
# Storage, AWS S3, Cloudflare R2 ve MinIO ayni kodla calisiyor.
#
#   Supabase Storage : S3_ENDPOINT=https://<proje>.supabase.co/storage/v1/s3
#                      S3_REGION=ca-central-1
#   AWS S3           : S3_ENDPOINT bos birakilir, yalnizca S3_REGION verilir
#   Cloudflare R2    : S3_ENDPOINT=https://<hesap>.r2.cloudflarestorage.com
#                      S3_REGION=auto
#
# S3_ENDPOINT verildiginde kova adi YOLA konuyor (path-style); AWS'te
# gerekmedigi icin yalnizca ozel uc noktalarda aciliyor.
#
# S3_PREFIX istege bagli: kovayi baska seylerle paylasiyorsan anahtarlarin
# onune eklenir. Veritabaninda saklanan /media/... adresini DEGISTIRMEZ.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=

# Testlerdeki S3 gidis-donusu YALNIZCA bu verilirse calisir:
#   pip install "moto[s3,server]" && python3 -m moto.server -p 5999
#   S3_TEST_ENDPOINT=http://127.0.0.1:5999 npm test
S3_TEST_ENDPOINT=

# ---- Gozlemleme ----
# SENTRY_DSN BOSSA HATA IZLEME TAMAMEN KAPALI: paket calisma aninda hic
# yuklenmiyor, tek bir istek bile cikmiyor. Gelistirmede boyle birakin.
#
# YALNIZCA SUNUCU tarafi izleniyor (sunucu bilesenleri, sunucu eylemleri,
# rota isleyicileri). Tarayici SDK'si paylasilan pakete ~30 kB ekledigi
# icin BILEREK eklenmedi.
#
# Giden her olay temizlenir (apps/web/src/lib/observability.ts):
# jeton ve e-posta gibi sorgu degerleri, cerezler, istek govdesi ve
# kullanici kimligi gonderilmez.
SENTRY_DSN=
# Istege bagli: olaylarin hangi ortamdan/surumden geldigini ayirmak icin.
# SENTRY_ENVIRONMENT bos birakilirsa NODE_ENV kullanilir.
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
NEXT_PUBLIC_POSTHOG_KEY=

# ---- Zamanli isler (cron) ----
# 36 saat icinde yanitlanmayan rezervasyon TALEPLERINI dolduran ucun
# kimligi. Ekranda "Talep 36 saat sonra kendiliginden duser" yaziyor;
# bu degisken tanimli degilse /api/cron/expire 503 doner ve o vaat
# TUTULMAZ. Uretimde ZORUNLU.
#   openssl rand -base64 32
#
# Vercel zamanli isleri bu degeri `Authorization: Bearer <deger>`
# basligiyla gonderir; vercel.json icindeki "crons" girdisi saatte bir
# calisir. Elle denemek icin:
#   curl -H "Authorization: Bearer $CRON_SECRET" https://<alan>/api/cron/expire
CRON_SECRET=

# ---- Yonetici paneli erisimi ----
# /admin ekranlari 1790 rezervasyonu, kullanici e-postalarini ve
# "mesaji ac" dugmesini tasiyor. Tek savunma hatti bir sifre olmamali.
#
# URETIMDE VARSAYILAN KAPALI: asagidakilerden biri verilmezse /admin
# adresi 404 doner (403 degil — 403 "burada bir panel var" demektir).
# Gelistirmede (NODE_ENV != production) bu kapi hic devreye girmez.
#
# Virgul ya da bosluklala ayrilmis adres listesi. IPv4'te CIDR calisir
# (10.0.0.0/8), IPv6'da yalnizca birebir esitlik.
ADMIN_IP_ALLOWLIST=
# Sabit IP'n yoksa bilerek acilmis kapi. Panel yine oturum istiyor ama
# giris ekrani internete acik oluyor — ADMIN_IP_ALLOWLIST tercih edilir.
ADMIN_ALLOW_ANY_IP=

# ---- Demo yayini ----
# DEMO_MODE=1 iken site ARAMA MOTORLARINA TAMAMEN KAPALI (robots.txt her
# seyi yasaklar, sitemap bosalir, her sayfa noindex) ve her sayfanin
# tepesinde "bu sitedeki bakicilar, yorumlar ve rezervasyonlar uydurma"
# seridi durur.
#
# Tohum veriyle dolu bir dagitimi uyarisiz internete acmak, sitenin
# ekranda yalan soylemesi demektir. Ayrica uydurma profiller Google'a
# girerse, gercek site acildiginda kendi icerigimizle rekabet ederiz.
#
# Vercel ONIZLEME dagitimlari (VERCEL_ENV=preview) kendiliginden demo
# sayilir; DEMO_MODE=0 bunu bilerek kapatir.
DEMO_MODE=

# ---- Demo girisi (yalnizca DEMO_MODE=1 ile) ----
# Demo yayininda ziyaretci e-posta beklemeden icerini gezebilsin diye
# giris ekraninda "sahip olarak gir" / "bakici olarak gir" dugmeleri
# cikiyor. Bu dugmeler UYDURMA tohum hesaplarina (@seed.havre.test)
# giriyor; parola tarayiciya HIC gitmiyor, sunucu kendi okuyor.
#
# Once parolayi hesaplara tanimla:
#   DEMO_LOGIN_PASSWORD=$(openssl rand -base64 24) npm run demo:accounts
# Sonra ayni degeri uygulamaya ver. Bos birakilirsa dugmeler 503 doner
# (sessizce calisan bir arka kapi olmasin diye acikca).
DEMO_LOGIN_PASSWORD=
