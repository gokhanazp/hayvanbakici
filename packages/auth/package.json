{
  "name": "@havre/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./password": {
      "types": "./dist/password.d.ts",
      "default": "./dist/password.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "demo:accounts": "tsx --env-file-if-exists=../../.env src/demo-accounts.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1136.0",
    "@havre/core": "0.1.0",
    "@havre/db": "0.1.0",
    "@havre/i18n": "0.1.0",
    "better-auth": "^1.7.4",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
