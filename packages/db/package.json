{
  "name": "@havre/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "studio": "drizzle-kit studio",
    "seed": "tsx --env-file-if-exists=../../.env src/seed.ts",
    "smoke": "tsx --env-file-if-exists=../../.env src/smoke.ts",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "admin": "tsx --env-file-if-exists=../../.env src/make-admin.ts",
    "users": "tsx --env-file-if-exists=../../.env src/users-list.ts"
  },
  "dependencies": {
    "@havre/core": "0.1.0",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
