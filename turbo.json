{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "DATABASE_URL",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_DEFAULT_LOCALE",
        "BETTER_AUTH_SECRET",
        "RESEND_API_KEY",
        "MAIL_FROM",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "APPLE_CLIENT_ID",
        "APPLE_CLIENT_SECRET",
        "APPLE_APP_BUNDLE_ID",
        "FIELD_ENCRYPTION_KEY",
        "CERTN_API_KEY",
        "CERTN_WEBHOOK_SECRET",
        "STORAGE_DRIVER",
        "ALLOW_LOCAL_STORAGE",
        "UPLOAD_DIR",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_BUCKET",
        "S3_ACCESS_KEY_ID",
        "S3_SECRET_ACCESS_KEY",
        "S3_PREFIX",
        "DB_POOL_MAX",
        "DB_APP_NAME",
        "MAIL_DRIVER",
        "SES_REGION",
        "SES_ENDPOINT",
        "SES_ACCESS_KEY_ID",
        "SES_SECRET_ACCESS_KEY",
        "SES_CONFIGURATION_SET",
        "CRON_SECRET",
        "SENTRY_DSN",
        "SENTRY_ENVIRONMENT",
        "SENTRY_RELEASE",
        "ADMIN_IP_ALLOWLIST",
        "ADMIN_ALLOW_ANY_IP",
        "DEMO_MODE",
        "VERCEL_ENV"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "^build"
      ],
      "env": [
        "DATABASE_URL",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_DEFAULT_LOCALE",
        "BETTER_AUTH_SECRET",
        "RESEND_API_KEY",
        "MAIL_FROM",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "APPLE_CLIENT_ID",
        "APPLE_CLIENT_SECRET",
        "APPLE_APP_BUNDLE_ID",
        "FIELD_ENCRYPTION_KEY",
        "CERTN_API_KEY",
        "CERTN_WEBHOOK_SECRET",
        "STORAGE_DRIVER",
        "ALLOW_LOCAL_STORAGE",
        "UPLOAD_DIR",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_BUCKET",
        "S3_ACCESS_KEY_ID",
        "S3_SECRET_ACCESS_KEY",
        "S3_PREFIX",
        "DB_POOL_MAX",
        "DB_APP_NAME",
        "MAIL_DRIVER",
        "SES_REGION",
        "SES_ENDPOINT",
        "SES_ACCESS_KEY_ID",
        "SES_SECRET_ACCESS_KEY",
        "SES_CONFIGURATION_SET",
        "CRON_SECRET",
        "SENTRY_DSN",
        "SENTRY_ENVIRONMENT",
        "SENTRY_RELEASE",
        "ADMIN_IP_ALLOWLIST",
        "ADMIN_ALLOW_ANY_IP",
        "DEMO_MODE",
        "VERCEL_ENV"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "DATABASE_URL",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_DEFAULT_LOCALE",
        "BETTER_AUTH_SECRET",
        "RESEND_API_KEY",
        "MAIL_FROM",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "APPLE_CLIENT_ID",
        "APPLE_CLIENT_SECRET",
        "APPLE_APP_BUNDLE_ID",
        "FIELD_ENCRYPTION_KEY",
        "CERTN_API_KEY",
        "CERTN_WEBHOOK_SECRET",
        "STORAGE_DRIVER",
        "ALLOW_LOCAL_STORAGE",
        "UPLOAD_DIR",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_BUCKET",
        "S3_ACCESS_KEY_ID",
        "S3_SECRET_ACCESS_KEY",
        "S3_PREFIX",
        "DB_POOL_MAX",
        "DB_APP_NAME",
        "MAIL_DRIVER",
        "SES_REGION",
        "SES_ENDPOINT",
        "SES_ACCESS_KEY_ID",
        "SES_SECRET_ACCESS_KEY",
        "SES_CONFIGURATION_SET",
        "CRON_SECRET",
        "SENTRY_DSN",
        "SENTRY_ENVIRONMENT",
        "SENTRY_RELEASE",
        "ADMIN_IP_ALLOWLIST",
        "ADMIN_ALLOW_ANY_IP",
        "DEMO_MODE",
        "VERCEL_ENV"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "FIELD_ENCRYPTION_KEY",
        "STORAGE_DRIVER",
        "ALLOW_LOCAL_STORAGE",
        "S3_TEST_ENDPOINT",
        "MAIL_DRIVER",
        "SES_REGION",
        "SES_ENDPOINT",
        "SES_TEST_ENDPOINT"
      ]
    },
    "lint": {}
  },
  "globalEnv": [
    "NODE_ENV"
  ],
  "globalDependencies": [
    ".env"
  ]
}
