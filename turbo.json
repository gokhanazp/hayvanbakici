{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "DATABASE_URL",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_DEFAULT_LOCALE",
        "BETTER_AUTH_SECRET",
        "RESEND_API_KEY",
        "MAIL_FROM",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "APPLE_CLIENT_ID",
        "APPLE_CLIENT_SECRET",
        "APPLE_APP_BUNDLE_ID"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "^build"
      ],
      "env": [
        "DATABASE_URL",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_DEFAULT_LOCALE",
        "BETTER_AUTH_SECRET",
        "RESEND_API_KEY",
        "MAIL_FROM",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "APPLE_CLIENT_ID",
        "APPLE_CLIENT_SECRET",
        "APPLE_APP_BUNDLE_ID"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "DATABASE_URL",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_DEFAULT_LOCALE",
        "BETTER_AUTH_SECRET",
        "RESEND_API_KEY",
        "MAIL_FROM",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "APPLE_CLIENT_ID",
        "APPLE_CLIENT_SECRET",
        "APPLE_APP_BUNDLE_ID"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "DATABASE_URL",
        "BETTER_AUTH_SECRET"
      ]
    },
    "lint": {}
  },
  "globalEnv": [
    "NODE_ENV"
  ],
  "globalDependencies": [
    ".env"
  ]
}
